<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml : usado APENAS para resolver as dependencias Java do projeto.

  Não há código Java para compilar aqui: todo o código-fonte é Python,
  executado pelo Jython. O Maven entra no Dockerfile (estágio "deps") só para
  baixar os JARs abaixo, que depois entram no classpath da JVM:

      org.python:jython-standalone   -> interpretador Python sobre a JVM
      org.xerial:sqlite-jdbc         -> driver JDBC do SQLite (java.sql)
      org.apache.commons:commons-text -> similaridade textual (fuzzy search)

  Download dos JARs:

      mvn -B dependency:copy-dependencies -DoutputDirectory=lib -DincludeScope=runtime
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>br.plp.jython</groupId>
  <artifactId>jython-ai-agent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Jython AI Agent</name>
  <description>Assistente tecnico agentivo em Python/Jython sobre a JVM</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>

    <jython.version>2.7.4</jython.version>
    <sqlite.jdbc.version>3.53.4.0</sqlite.jdbc.version>
    <commons.text.version>1.15.0</commons.text.version>
    <stella.version>2.2.2</stella.version>
  </properties>

  <dependencies>
    <!-- Interpretador Python sobre a JVM -->
    <dependency>
      <groupId>org.python</groupId>
      <artifactId>jython-standalone</artifactId>
      <version>${jython.version}</version>
    </dependency>

    <!-- Banco de dados: java.sql + JDBC -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.jdbc.version}</version>
    </dependency>

    <!-- Similaridade textual: JaroWinklerSimilarity, LevenshteinDistance -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>${commons.text.version}</version>
    </dependency>

    <!-- Validação e formatação determinística de documentos brasileiros. -->
    <dependency>
      <groupId>br.com.caelum.stella</groupId>
      <artifactId>caelum-stella-core</artifactId>
      <version>${stella.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
      </plugin>
    </plugins>
  </build>

</project>
